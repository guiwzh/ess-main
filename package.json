{
  "name": "ess-main-template",
  "version": "1.1.0",
  "description": "React 19 微前端储能运维管理平台主应用模板",
  "author": "guiwz",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "orval": "orval",
    "prepare": "husky"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.1",
    "@ant-design/pro-components": "^2.8.10",
    "antd": "^5.29.3",
    "axios": "^1.15.0",
    "i18next": "^26.0.4",
    "i18next-http-backend": "^3.0.4",
    "nprogress": "^0.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.2",
    "react-router-dom": "^7.14.0",
    "wujie-react": "^1.0.29",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "less": "^4.6.4",
    "lint-staged": "^16.4.0",
    "orval": "^8.8.0",
    "prettier": "^3.8.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-font": "^5.1.2",
    "vite-plugin-mock-dev-server": "^2.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "cn-font-split",
      "koffi",
      "protobufjs",
      "esbuild"
    ],
    "overrides": {
      "koffi": "2.10.0"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,less,css,md}": [
      "prettier --write"
    ]
  }
}
