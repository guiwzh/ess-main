{
  "openapi": "3.0.3",
  "info": {
    "title": "ESS Main API",
    "version": "1.0.0"
  },
  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "login",
        "tags": ["auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginParams"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiResponseBase"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/LoginData"
                        }
                      },
                      "required": ["data"]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/user/info": {
      "get": {
        "operationId": "getUserInfo",
        "tags": ["user"],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiResponseBase"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/UserInfo"
                        }
                      },
                      "required": ["data"]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/user/routes": {
      "get": {
        "operationId": "getUserRoutes",
        "tags": ["user"],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiResponseBase"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/RouteItem"
                          }
                        }
                      },
                      "required": ["data"]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/user/stations": {
      "get": {
        "operationId": "getUserStations",
        "tags": ["user"],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiResponseBase"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Station"
                          }
                        }
                      },
                      "required": ["data"]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponseBase": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "LoginParams": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "LoginData": {
        "type": "object",
        "required": ["accessToken", "refreshToken"],
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "required": ["id", "username", "realName", "roles", "permissions"],
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "realName": {
            "type": "string"
          },
          "avatar": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SubAppConfig": {
        "type": "object",
        "required": ["name", "url"],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "alive": {
            "type": "boolean"
          }
        }
      },
      "RouteMeta": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": {
            "type": "string"
          },
          "hideInMenu": {
            "type": "boolean"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "RouteItem": {
        "type": "object",
        "required": ["path", "dictKey"],
        "properties": {
          "path": {
            "type": "string"
          },
          "dictKey": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "component": {
            "type": "string"
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RouteItem"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/RouteMeta"
          },
          "subApp": {
            "$ref": "#/components/schemas/SubAppConfig"
          }
        }
      },
      "Station": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    }
  }
}
